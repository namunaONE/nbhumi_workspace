# nBhumi environment variables — copy to .env.local (gitignored) and fill in.
# NEVER commit .env or .env.local to git (Rule 7). Use --dart-define for Flutter
# runs. The only values that ever belonged in this example are placeholders.
#
# Get the publishable key from the Supabase dashboard: Project Settings -> API.
# It is RLS-bound and safe inside a client bundle, but it does not belong in git
# history. The `service_role` key must NEVER appear here — it bypasses RLS and
# stays on the server (Rule 2).

# Supabase (project: nbhumi, region: ap-southeast-1)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Environment: dev | staging | prod
ENVIRONMENT=dev

# Sentry (prod only)
SENTRY_DSN=

# HYA-239 flavors. The Makefile reads these from the shell, not from this
# file. Android emulator reaches local Supabase at 10.0.2.2, not 127.0.0.1.
# Staging backend does not exist yet (HYA-284); leave these unset until then.
# SUPABASE_URL_DEV=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=<local publishable key>
# SUPABASE_URL_STAGING=https://<staging-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY_STAGING=<staging publishable key>
# SUPABASE_URL_PROD=https://your-prod-ref.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<prod publishable key>
