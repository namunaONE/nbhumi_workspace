# nBhumi environment variables — copy to .env and fill in values.
# NEVER commit .env to git (Rule 7). Use --dart-define for Flutter runs.

# Supabase (project: nbhumi, region: ap-southeast-1)
SUPABASE_URL=https://rerjioibpqvcomdingte.supabase.co
SUPABASE_ANON_KEY=sb_publishable_DaQ2qWXImnMaQ_TV8Zedvg_xcGvy_v3

# Environment: dev | staging | prod
ENVIRONMENT=dev

# Sentry (prod only)
SENTRY_DSN=

# HYA-239 flavors. The Makefile reads these from the shell, not from this
# file. Android emulator reaches local Supabase at 10.0.2.2, not 127.0.0.1.
# Staging backend does not exist yet (HYA-284); leave these unset until then.
# SUPABASE_URL_DEV=http://127.0.0.1:54321
# SUPABASE_PUBLISHABLE_KEY=<local publishable key>
# SUPABASE_URL_STAGING=https://<staging-ref>.supabase.co
# SUPABASE_PUBLISHABLE_KEY_STAGING=<staging publishable key>
# SUPABASE_URL_PROD=https://rerjioibpqvcomdingte.supabase.co
# SUPABASE_PUBLISHABLE_KEY=<prod publishable key>
